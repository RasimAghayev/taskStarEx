# Copy this file to .env (gitignored, never committed) and fill in real
# values for your environment. Used by docker-compose.yml only — the
# Laravel app itself reads src/be/.env (see src/be/.env.example) and the
# Nuxt app reads src/fe/.env (see src/fe/.env.example).

# --- Postgres (dev-only local credentials; never reuse in a real env) -----
POSTGRES_DB=laraveldb
POSTGRES_USER=laravel
POSTGRES_PASSWORD=changeme-generate-your-own
POSTGRES_PORT=20252

# --- Host port mappings ----------------------------------------------------
# Reserved block 20250-20259 for taskStarEx, see projects/info/state/ports.md
APP_PORT=20250
FE_PORT=20251

# --- Frontend -> backend API URL, as seen from the browser ----------------
NUXT_PUBLIC_API_URL=http://localhost:20250/api
