	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"function randomString(minValue, maxValue, dataSet = 'abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ') {\r",
					"    if (!minValue) {\r",
					"        minValue = 20;\r",
					"        maxValue = 20;\r",
					"    }\r",
					"\r",
					"    if (!maxValue) {\r",
					"        maxValue = minValue;\r",
					"    }\r",
					"\r",
					"    let length = _.random(minValue, maxValue),\r",
					"        randomString = \"\";\r",
					"\r",
					"    for (let i = 0; i < length; i++)\r",
					"        randomString += dataSet.charAt(Math.floor(Math.random() * dataSet.length));\r",
					"    return randomString;\r",
					"}\r",
					"\r",
					"pm.variables.set('randomFIN', randomString(7,7,'0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'));\r",
					"\r",
					"function randomDate() {\r",
					"    let start=new Date(1950, 0, 1);\r",
					"        end=new Date(),\r",
					"        d = new Date(\r",
					"            start.getTime() + \r",
					"            Math.random() * \r",
					"            (\r",
					"                end.getTime() - \r",
					"                start.getTime()\r",
					"            )\r",
					"        ),\r",
					"        month = '' + (d.getMonth() + 1),\r",
					"        day = '' + d.getDate(),\r",
					"        year = d.getFullYear();\r",
					"\r",
					"    if (month.length < 2) month = '0' + month;\r",
					"    if (day.length < 2) day = '0' + day;\r",
					"\r",
					"    return [year, month, day].join('-');\r",
					"}\r",
					"pm.variables.set('randomDateSpec', randomDate());\r",
					"\r",
					"\r",
					"function getRandomItem() {\r",
					"    let set=['new_register','it_works','vacation','maternity_leave','education','business_trip','out','removed']\r",
					"    let items = Array.from(set);\r",
					"    return items[Math.floor(Math.random() * items.length)];\r",
					"}\r",
					"\r",
					"\r",
					"pm.variables.set('randomUserStatus', getRandomItem());\r",
					"\r",
					"\r",
					""
				]
			}
